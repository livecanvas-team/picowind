{
    "compilerOptions": {
        "target": "ES2022",
        "useDefineForClassFields": true,
        "module": "ESNext",
        "lib": [
            "ES2022",
            "DOM",
            "DOM.Iterable",
            "WebWorker",
        ],
        "skipLibCheck": true,
        /* Bundler mode */
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "isolatedModules": true,
        "moduleDetection": "force",
        "noEmit": true,
        "jsx": "preserve",
        /* Linting */
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true,

        /* Paths */
        "paths": {
            "~/*": [
                "./*"
            ],
            "@/admin/*": [
                "./resources/admin/*"
            ],
            "@/components/*": [
                "./resources/components/*"
            ],
            "@/*": [
                "./resources/*"
            ],
        },
        "types": [
            "vite/client"
        ]
    },
    "include": [
        "resources/**/*.ts",
        "resources/**/*.tsx",
        "resources/declarations.d.ts"
    ]
}
